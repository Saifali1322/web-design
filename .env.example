# Juice Cartel — environment
#
# Copy to `.env.local` and fill in. The site is built to run with none of these
# set: pages render, the basket works, and the checkout button quietly switches
# to "Ordering opens soon" instead of erroring. Add the keys when ordering goes
# live.
#
#   cp .env.example .env.local
#
# Never commit .env.local — it is git-ignored.


# ---------------------------------------------------------------------------
# Stripe secret key                                              (required)
# ---------------------------------------------------------------------------
# Server-side only — this key can move money, so it must never reach the
# browser. Do not prefix it with NEXT_PUBLIC_.
#
# Where: Stripe dashboard → Developers → API keys → Secret key.
# Use the test key (sk_test_...) until you are ready to take real money;
# swap to sk_live_... in production only.
STRIPE_SECRET_KEY=sk_test_replace_me


# ---------------------------------------------------------------------------
# Stripe webhook signing secret                                  (required)
# ---------------------------------------------------------------------------
# Proves an incoming webhook really came from Stripe. Without it /api/webhook
# rejects everything, and you get no order notifications.
#
# Local development — run this in a second terminal and copy the whsec_ it
# prints:
#   stripe listen --forward-to localhost:3000/api/webhook
#
# Production — Stripe dashboard → Developers → Webhooks → add an endpoint at
# https://your-domain/api/webhook, then copy its signing secret.
# Events to send: checkout.session.completed, customer.subscription.deleted
#
# The local and live secrets are different values. Keep them apart.
STRIPE_WEBHOOK_SECRET=whsec_replace_me


# ---------------------------------------------------------------------------
# Public site URL                                             (recommended)
# ---------------------------------------------------------------------------
# The origin Stripe returns customers to after paying or cancelling. No
# trailing slash.
#
# Local:      http://localhost:3000
# Production: https://juicecartel.uk
#
# If unset, the app falls back to the Vercel deployment URL, then to
# http://localhost:3000 — fine in development, wrong in production, so set it
# on the live deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
